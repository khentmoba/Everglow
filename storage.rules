rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Gallery uploads are scoped to the authenticated user's UID. The app
    // reads through download URLs / the proxy, so reads are owner-scoped
    // here and the couple sharing is enforced by Firestore + the proxy.
    match /gallery/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user memory uploads are scoped to the owner UID.
    match /memories/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Milestone uploads are scoped to the uploading user's UID. Download
    // URLs carry their own read tokens for the couple's shared viewing.
    match /milestones/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied until a path-specific rule exists.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
