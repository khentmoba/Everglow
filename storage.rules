rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /milestones/{allPaths=**} {
      allow read: if true;
      allow write: if true; // For now, allow public write for khent to upload
    }
  }
}
