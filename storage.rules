rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Couple users share the gallery; writes are scoped to the path's
    // username segment matching the authenticated user's username.
    match /gallery/{username}/{allPaths=**} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username in ['khentsgdz', 'clairjassen'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
      );
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    // Per-user memory uploads are scoped to the owner uid; the couple
    // can read each other's files.
    match /memories/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username in ['khentsgdz', 'clairjassen']
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared couple milestones are private to Khent and Clair.
    match /milestones/{allPaths=**} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username in ['khentsgdz', 'clairjassen'];
    }

    // Everything else is denied until a path-specific rule exists.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
