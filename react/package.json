{
  "name": "everglow-react",
  "private": true,
  "version": "6.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open=false",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src --max-warnings=115",
    "test": "node tools/check_dist.mjs && node --experimental-strip-types --test tools/*.test.mjs",
    "test:one": "node tools/check_dist.mjs && node --experimental-strip-types --test",
    "preview": "vite preview --open=false"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "material-icons": "1.13.14",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.65.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "7.3.8"
  }
}
