rules_version = '2';

// Everglow Firestore security rules.
//
// Access model:
//   * Anonymous auth is not allowed for app data.
//   * A registered user must have a /users/{uid} document whose username is
//     one of the four known profiles.
//   * Khent and Clair are the "couple" and own the shared scrapbook data.
//   * Breyan and Octagram are cinema-only profiles; they can use their own
//     watch list, games, and academy data, but not couple-only collections.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isNotAnonymous() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isRegistered() {
      return isAuthenticated() && isNotAnonymous() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function username() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function isCouple() {
      return isRegistered() &&
        username() in ['khentsgdz', 'clairjassen'];
    }

    function isCinemaProfile() {
      return isRegistered() &&
        username() in ['breyan', 'octagram'];
    }

    function isAppUser() {
      return isCouple() || isCinemaProfile();
    }

    function isCouplePair(uidA, uidB) {
      return uidA != null && uidB != null && uidA != uidB &&
        get(/databases/$(database)/documents/users/$(uidA)).data.username in ['khentsgdz', 'clairjassen'] &&
        get(/databases/$(database)/documents/users/$(uidB)).data.username in ['khentsgdz', 'clairjassen'];
    }

    function ownerOf(userId) {
      return isRegistered() && request.auth.uid == userId;
    }

    // ---------- User profile and per-user subcollections ----------

    match /users/{userId} {
      allow create: if isAuthenticated() && isNotAnonymous() &&
        request.auth.uid == userId &&
        request.resource.data.username in ['khentsgdz', 'clairjassen', 'breyan', 'octagram'];
      allow read: if isRegistered();
      allow update: if ownerOf(userId) &&
        resource.data.username == request.resource.data.username && request.resource.data.keys().hasOnly(['username', 'partnerUsername', 'updatedAt', 'createdAt']);
      allow delete: if ownerOf(userId);
    }

    match /users/{userId}/progress/{docId} {
      allow read, write: if ownerOf(userId);
    }

    match /users/{userId}/ai_conversations/{docId} {
      allow read, write: if ownerOf(userId);
    }

    match /users/{userId}/garden_stats/{docId} {
      allow read, write: if ownerOf(userId);
    }

    // ---------- Couple-only shared data ----------

    match /sanctuary_messages/{messageId} {
      allow read: if isCouple();
      allow create: if isCouple() && request.resource.data.size() < 8192 && request.resource.data.text is string && request.resource.data.text.size() < 5000;
      allow update: if isCouple() && request.resource.data.size() < 8192;
      allow delete: if isCouple();
    }

    match /watch_party_rooms/{roomId} {
      allow read: if isCouple() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid == resource.data.partnerUid
      );
      allow create: if isCouple() &&
        (request.auth.uid == request.resource.data.hostUid ||
         request.auth.uid == request.resource.data.partnerUid) &&
        isCouplePair(request.resource.data.hostUid, request.resource.data.partnerUid) &&
        isValidRoomShape(request.resource.data);
      allow update: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid) &&
        isValidRoomShape(request.resource.data) &&
        request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.partnerUid == resource.data.partnerUid;
      allow delete: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid);
    }

    match /watch_party_chats/{roomId}/messages/{messageId} {
      allow read, write: if isCouple() &&
        (request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.hostUid ||
         request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.partnerUid);
    }

    match /temporary_chats/{roomId} {
      allow read: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid);
      allow create: if isCouple() &&
        (request.auth.uid == request.resource.data.hostUid ||
         request.auth.uid == request.resource.data.partnerUid) &&
        isCouplePair(request.resource.data.hostUid, request.resource.data.partnerUid);
      allow update, delete: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid);

      match /messages/{messageId} {
        allow read, write: if isCouple() &&
          (request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.hostUid ||
           request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.partnerUid);
      }
    }

    match /voice_rooms/{roomId} {
      allow read: if isCouple() &&
        (request.auth.uid == resource.data.callerUid ||
         request.auth.uid == resource.data.calleeUid);
      allow create: if isCouple() &&
        (request.auth.uid == request.resource.data.callerUid ||
         request.auth.uid == request.resource.data.calleeUid) &&
        isCouplePair(request.resource.data.callerUid, request.resource.data.calleeUid) &&
        isValidVoiceRoomShape(request.resource.data);
      allow update: if isCouple() &&
        (request.auth.uid == resource.data.callerUid ||
         request.auth.uid == resource.data.calleeUid) &&
        isValidVoiceRoomShape(request.resource.data) &&
        request.resource.data.callerUid == resource.data.callerUid &&
        request.resource.data.calleeUid == resource.data.calleeUid;
      allow delete: if isCouple() &&
        (request.auth.uid == resource.data.callerUid ||
         request.auth.uid == resource.data.calleeUid);

      match /candidates/{candidateId} {
        allow read, write: if isCouple() &&
          (request.auth.uid == get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.callerUid ||
           request.auth.uid == get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.calleeUid);
      }
    }

    match /gallery/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /memories/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /notes/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /milestones/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /moods/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /music_status/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /presence/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /starlight_jar/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 8192 && request.resource.data.content is string && request.resource.data.content.size() < 5000; allow update: if isCouple() && request.resource.data.size() < 8192; allow delete: if isCouple(); }
    match /calendar_events/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /bucket_list/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /our_cinema/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /our_books/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /read_list/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /date_ideas/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /guardian_messages/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /canvas_strokes/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /live_canvas/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /manga_library/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /manga_library/{docId}/bookmarks/{bookmarkId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 10240; allow update: if isCouple() && request.resource.data.size() < 10240; allow delete: if isCouple(); }
    match /katana_bookmarks/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /ai_memories/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /ai_memories/{docId}/facts/{factId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 10240; allow update: if isCouple() && request.resource.data.size() < 10240; allow delete: if isCouple(); }
    match /ai_memories/{docId}/sessions/{sessionId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /recent_activity/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }

    // ---------- Shared app data for all four profiles ----------

    match /academy_questions/{docId} {
      allow read, write: if isAppUser();
    }
    match /active_matches/{docId} {
      allow read, write: if isAppUser();
    }
    match /tt_rooms/{roomId} {
      allow read: if isAppUser();
      allow create: if isAppUser() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'waiting';
      allow update: if isAppUser() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.guestUid);
      allow delete: if isAppUser() &&
        request.auth.uid == resource.data.hostUid;
    }
    match /watch_list/{docId} {
      allow read: if isCouple() ||
        (isCinemaProfile() && resource.data.userName == username());
      allow create: if isCouple() ||
        (isCinemaProfile() && request.resource.data.userName == username());
      allow update, delete: if isCouple() ||
        (isCinemaProfile() && resource.data.userName == username());
    }
    match /fcm_tokens/{docId} {
      allow read: if isAppUser() && docId == username();
      allow write: if isAppUser() && docId == username();
    }
    match /config/{docId} {
      allow read: if isRegistered();
    }
    match /spotify_tokens/{userId} {
      allow read, write: if ownerOf(userId);
    }

    // Server-only collections
    match /reminders/{docId} { allow read, write: if false; }
    match /music/{docId} { allow read, write: if false; }
    match /garden_plants/{docId} { allow read, write: if false; }
    match /canvas_drawings/{docId} { allow read, write: if false; }
    match /playzone_scores/{docId} { allow read, write: if false; }
    match /relationship_stats/{docId} { allow read, write: if false; }
    match /mochi_notes/{docId} { allow read, write: if false; }
    match /mochi_stats/{docId} { allow read, write: if false; }
    match /mochi_stats/{docId}/{subcol}/{subId} { allow read, write: if false; }
    match /daily_digest/{docId} { allow read, write: if false; }
  }
}

// ---------- Shape validators ----------

function isValidRoomShape(data) {
  return data.keys().hasAll([
        'hostUid',
        'hostName',
        'partnerUid',
        'partnerName',
        'mediaType',
        'state',
        'updatedAt',
        'updatedBy',
        'active',
      ]) &&
      data.mediaType in ['movie', 'tv'] &&
      data.state in ['playing', 'paused', 'buffering'] &&
      data.active is bool;
}

function isValidVoiceRoomShape(data) {
  return data.keys().hasAll(['callerUid', 'calleeUid', 'state', 'updatedAt']) &&
      data.callerUid is string &&
      data.calleeUid is string &&
      data.state in ['ringing', 'calling', 'connected', 'ended'] &&
      (!('offer' in data) || data.offer is string) &&
      (!('answer' in data) || data.answer is string);
}
