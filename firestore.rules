rules_version = '2';

// Everglow Firestore security rules.
//
// Access model:
//   * Anonymous auth is not allowed for app data.
//   * A registered user must have a /users/{uid} document whose username is
//     one of the four known profiles.
//   * Khent and Clair are the "couple" and own the shared scrapbook data.
//   * Breyan and Octagram are cinema-only profiles; they can use their own
//     watch list, games, and academy data, but not couple-only collections.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isNotAnonymous() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isRegistered() {
      return isAuthenticated() && isNotAnonymous() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function username() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    // verifyPasscode already signs this identity into the Firebase token.
    // A client-writable profile name must never grant couple access.
    function hasCoupleIdentity() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider == 'custom' &&
        'username' in request.auth.token &&
        request.auth.token.username in ['khentsgdz', 'clairjassen'];
    }

    function isCouple() {
      return isRegistered() && hasCoupleIdentity() &&
        username() == request.auth.token.username;
    }

    function isCinemaProfile() {
      return isRegistered() &&
        username() in ['breyan', 'octagram'];
    }

    function isAppUser() {
      return isCouple() || isCinemaProfile();
    }

    function isCouplePair(uidA, uidB) {
      return uidA != null && uidB != null && uidA != uidB &&
        get(/databases/$(database)/documents/users/$(uidA)).data.username in ['khentsgdz', 'clairjassen'] &&
        get(/databases/$(database)/documents/users/$(uidB)).data.username in ['khentsgdz', 'clairjassen'];
    }

    function ownerOf(userId) {
      return isRegistered() && request.auth.uid == userId;
    }

    function isValidRoomShape(data) {
      return data.keys().hasAll([
            'hostUid',
            'hostName',
            'partnerUid',
            'partnerName',
            'mediaType',
            'state',
            'updatedAt',
            'updatedBy',
            'active',
          ]) &&
          data.mediaType in ['movie', 'tv'] &&
          data.state in ['playing', 'paused', 'buffering'] &&
          data.active is bool;
    }

    function isValidVoiceRoomShape(data) {
      return data.keys().hasAll(['callerUid', 'calleeUid', 'state', 'updatedAt']) &&
          data.callerUid is string &&
          data.calleeUid is string &&
          data.state in ['ringing', 'calling', 'connected', 'ended'] &&
          (!('offer' in data) || data.offer is string) &&
          (!('answer' in data) || data.answer is string);
    }

    function isValidAcademyQuestionShape(data) {
      return data.keys().hasAll([
            'id',
            'questionText',
            'options',
            'correctOptionIndex',
            'category',
          ]) &&
          data.id is string &&
          data.questionText is string &&
          data.questionText.size() > 0 &&
          data.questionText.size() < 2000 &&
          data.options is list &&
          data.options.size() >= 2 &&
          data.options.size() <= 6 &&
          data.correctOptionIndex is int &&
          data.correctOptionIndex >= 0 &&
          data.correctOptionIndex < data.options.size() &&
          data.category is string &&
          (!('explanation' in data) ||
            (data.explanation is string &&
              data.explanation.size() < 2000)) &&
          data.size() < 8192;
    }

    function isValidMatchShape(data) {
      return data.keys().hasAll([
            'hostId',
            'status',
            'category',
            'questionIndex',
            'currentQuestionId',
          ]) &&
          data.hostId is string &&
          data.status in ['waiting', 'active', 'finished'] &&
          data.category is string &&
          data.questionIndex is int &&
          data.questionIndex >= 0 &&
          data.questionIndex <= 10 &&
          data.currentQuestionId is string &&
          (!('questionIds' in data) ||
            (data.questionIds is list &&
              data.questionIds.size() <= 20)) &&
          (!('hostUsername' in data) || data.hostUsername is string) &&
          (!('participantUsername' in data) ||
            data.participantUsername is string) &&
          data.size() < 8192;
    }

    function isMatchAdvance() {
      let nextIndex = resource.data.questionIndex + 1;
      let questionIds = ('questionIds' in resource.data)
        ? resource.data.questionIds
        : [];
      let finished = nextIndex >= questionIds.size();
      return request.resource.data.questionIndex == nextIndex &&
        request.resource.data.status == (finished ? 'finished' : 'active') &&
        request.resource.data.currentQuestionId ==
          (finished ? '' : questionIds[nextIndex]);
    }

    function isMatchWinner() {
      let host = ('hostUsername' in resource.data &&
        resource.data.hostUsername is string)
        ? resource.data.hostUsername : 'draw';
      let guest = ('participantUsername' in resource.data &&
        resource.data.participantUsername is string)
        ? resource.data.participantUsername : 'draw';
      let winner = request.resource.data.hostScore > request.resource.data.guestScore
        ? host
        : (request.resource.data.guestScore > request.resource.data.hostScore
          ? guest : 'draw');
      return request.resource.data.winnerId == winner;
    }

    function isMatchScoreUpdate() {
      let hostScore = resource.data.get('hostScore', resource.data.get('khentScore', 0));
      let guestScore = resource.data.get('guestScore', resource.data.get('clairScore', 0));
      return (request.auth.uid == resource.data.hostId &&
          request.resource.data.hostScore == hostScore + 10 &&
          request.resource.data.guestScore == guestScore) ||
        (request.auth.uid == resource.data.participantId &&
          request.resource.data.hostScore == hostScore &&
          request.resource.data.guestScore == guestScore + 10);
    }

    // ---------- User profile and per-user subcollections ----------

    match /users/{userId} {
      allow create: if isAuthenticated() && isNotAnonymous() &&
        request.auth.uid == userId &&
        (request.resource.data.username in ['breyan', 'octagram'] ||
          (hasCoupleIdentity() &&
            request.resource.data.username == request.auth.token.username));
      allow read: if isRegistered();
      allow update: if ownerOf(userId) &&
        resource.data.username == request.resource.data.username && request.resource.data.keys().hasOnly(['username', 'partnerUsername', 'updatedAt', 'createdAt']);
      allow delete: if ownerOf(userId);
    }

    match /users/{userId}/progress/{docId} {
      allow read, write: if ownerOf(userId);
    }

    match /users/{userId}/ai_conversations/{docId} {
      allow read, write: if ownerOf(userId);
    }

    match /users/{userId}/garden_stats/{docId} {
      allow read: if isCouple();
      allow write: if isCouple() && ownerOf(userId);
    }

    // ---------- Couple-only shared data ----------

    match /sanctuary_messages/{messageId} {
      allow read: if isCouple();
      allow create: if isCouple() && request.resource.data.size() < 8192 && request.resource.data.text is string && request.resource.data.text.size() < 5000;
      allow update: if isCouple() && request.resource.data.size() < 8192 && request.resource.data.text is string && request.resource.data.text.size() < 8192 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt', 'editedAt', 'edited']);
      allow delete: if isCouple();
    }

    match /watch_party_rooms/{roomId} {
      allow read: if isCouple() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid == resource.data.partnerUid
      );
      allow create: if isCouple() &&
        (request.auth.uid == request.resource.data.hostUid ||
         request.auth.uid == request.resource.data.partnerUid) &&
        isCouplePair(request.resource.data.hostUid, request.resource.data.partnerUid) &&
        isValidRoomShape(request.resource.data);
      allow update: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid) &&
        isValidRoomShape(request.resource.data) &&
        ((request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.partnerUid == resource.data.partnerUid) ||
         // The other partner may host the next night, never replace the pair.
         ((!resource.data.active ||
           (resource.data.updatedAt is timestamp &&
            resource.data.updatedAt < request.time - duration.value(15, 'm'))) &&
          request.resource.data.hostUid == request.auth.uid &&
          request.resource.data.hostUid == resource.data.partnerUid &&
          request.resource.data.partnerUid == resource.data.hostUid));
      allow delete: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid);
    }

    match /watch_party_chats/{roomId}/messages/{messageId} {
      allow read: if isCouple() &&
        (request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.hostUid ||
         request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.partnerUid);
      allow create: if isCouple() &&
        (request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.hostUid ||
         request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.partnerUid) &&
        request.resource.data.size() < 8192 && request.resource.data.text is string && request.resource.data.text.size() < 5000;
      allow update, delete: if isCouple() &&
        (request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.hostUid ||
         request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.partnerUid);
    }

    match /temporary_chats/{roomId} {
      allow read: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid);
      allow create: if isCouple() &&
        (request.auth.uid == request.resource.data.hostUid ||
         request.auth.uid == request.resource.data.partnerUid) &&
        isCouplePair(request.resource.data.hostUid, request.resource.data.partnerUid);
      allow update, delete: if isCouple() &&
        (request.auth.uid == resource.data.hostUid ||
         request.auth.uid == resource.data.partnerUid);

      match /messages/{messageId} {
        allow read: if isCouple() &&
          (request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.hostUid ||
           request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.partnerUid);
        allow create: if isCouple() &&
          (request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.hostUid ||
           request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.partnerUid) &&
          request.resource.data.size() < 8192 && request.resource.data.text is string && request.resource.data.text.size() < 5000;
        allow update, delete: if isCouple() &&
          (request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.hostUid ||
           request.auth.uid == get(/databases/$(database)/documents/temporary_chats/$(roomId)).data.partnerUid);
      }
    }

    match /voice_rooms/{roomId} {
      allow read: if isCouple() &&
        (request.auth.uid == resource.data.callerUid ||
         request.auth.uid == resource.data.calleeUid);
      allow create: if isCouple() &&
        (request.auth.uid == request.resource.data.callerUid ||
         request.auth.uid == request.resource.data.calleeUid) &&
        isCouplePair(request.resource.data.callerUid, request.resource.data.calleeUid) &&
        isValidVoiceRoomShape(request.resource.data);
      allow update: if isCouple() &&
        (request.auth.uid == resource.data.callerUid ||
         request.auth.uid == resource.data.calleeUid) &&
        isValidVoiceRoomShape(request.resource.data) &&
        request.resource.data.callerUid == resource.data.callerUid &&
        request.resource.data.calleeUid == resource.data.calleeUid;
      allow delete: if isCouple() &&
        (request.auth.uid == resource.data.callerUid ||
         request.auth.uid == resource.data.calleeUid);

      match /candidates/{candidateId} {
        allow read, write: if isCouple() &&
          (request.auth.uid == get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.callerUid ||
           request.auth.uid == get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.calleeUid);
      }
    }

    match /discord_watch_sessions/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 8192; allow update: if isCouple() && request.resource.data.size() < 8192; allow delete: if isCouple(); }

    match /gallery/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /memories/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /notes/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /milestones/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /moods/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /music_status/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /jukebox_dedications/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /presence/{docId} { allow read: if isCouple(); allow create: if isCouple() && docId == request.auth.uid && request.resource.data.size() < 102400; allow update: if isCouple() && docId == request.auth.uid && request.resource.data.size() < 102400; allow delete: if isCouple() && docId == request.auth.uid; }
    match /presence_sessions/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.uid == request.auth.uid && request.resource.data.size() < 102400; allow update: if isCouple() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.size() < 102400; allow delete: if isCouple() && resource.data.uid == request.auth.uid; }
    match /starlight_jar/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 8192 && request.resource.data.content is string && request.resource.data.content.size() < 5000; allow update: if isCouple() && request.resource.data.size() < 8192 && request.resource.data.content is string && request.resource.data.content.size() < 5000 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt', 'opened', 'openedAt']); allow delete: if isCouple(); }
    match /calendar_events/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /calendar_polls/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /tonight_decisions/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /bucket_list/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /journal_entries/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /subscriptions/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /recipes/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /meal_plans/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /habits/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /workouts/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /vault_entries/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /scribble_rooms/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /chess_rooms/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /motchi_games/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /travel_trips/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /travel_pins/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /wiki_shelves/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /wiki_books/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /wiki_pages/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /budget_transactions/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /budget_limits/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /our_cinema/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /our_books/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /read_list/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /book_favorites/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /book_download_history/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /date_ideas/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /guardian_messages/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /canvas_strokes/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /live_canvas/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /manga_library/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /manga_library/{docId}/bookmarks/{bookmarkId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 10240; allow update: if isCouple() && request.resource.data.size() < 10240; allow delete: if isCouple(); }
    match /katana_bookmarks/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /ai_memories/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /ai_memories/{docId}/facts/{factId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 10240; allow update: if isCouple() && request.resource.data.size() < 10240; allow delete: if isCouple(); }
    match /ai_memories/{docId}/sessions/{sessionId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /ai_memories/{docId}/study_sessions/{studySessionId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }
    match /recent_activity/{docId} { allow read: if isCouple(); allow create: if isCouple() && request.resource.data.size() < 102400; allow update: if isCouple() && request.resource.data.size() < 102400; allow delete: if isCouple(); }

    // ---------- Shared app data for all four profiles ----------

    match /academy_questions/{docId} {
      allow read: if isAppUser();
      allow create: if isAppUser() && isValidAcademyQuestionShape(request.resource.data);
      allow update: if isAppUser() &&
        isValidAcademyQuestionShape(request.resource.data);
      allow delete: if false;
    }
    match /active_matches/{docId} {
      allow read: if isAppUser();
      allow create: if isAppUser() &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.participantId == null &&
        request.resource.data.hostScore == 0 &&
        request.resource.data.guestScore == 0 &&
        request.resource.data.status == 'waiting' &&
        isValidMatchShape(request.resource.data);
      allow update: if isAppUser() &&
        isValidMatchShape(request.resource.data) &&
        request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.category == resource.data.category &&
        (
          // A guest can claim only the empty seat, not rewrite the match.
          (resource.data.status == 'waiting' &&
           resource.data.participantId == null &&
           request.resource.data.status == 'active' &&
           resource.data.hostId != request.auth.uid &&
           request.resource.data.participantId == request.auth.uid &&
           request.resource.data.participantUsername == username() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'participantId', 'participantUsername'])) ||
          // Host can replace the question order only while waiting.
          (request.auth.uid == resource.data.hostId &&
           resource.data.status == 'waiting' &&
           request.resource.data.status == 'waiting' &&
           request.resource.data.questionIndex == 0 &&
           request.resource.data.questionIds is list &&
           request.resource.data.questionIds.size() > 0 &&
           request.resource.data.questionIds.size() <= 10 &&
           request.resource.data.currentQuestionId ==
             request.resource.data.questionIds[0] &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['questionIds', 'currentQuestionId', 'questionIndex'])) ||
          // Either player may toggle the replenishment indicator.
          ((request.auth.uid == resource.data.hostId ||
            request.auth.uid == resource.data.participantId) &&
           request.resource.data.isReplenishing is bool &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isReplenishing'])) ||
          // A correct answer advances one question and credits only its sender.
          (resource.data.status == 'active' &&
           (request.auth.uid == resource.data.hostId ||
            request.auth.uid == resource.data.participantId) &&
           isMatchAdvance() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['hostScore', 'guestScore', 'questionIndex',
                       'currentQuestionId', 'status', 'winnerId']) &&
           ((request.resource.data.status == 'active' &&
             request.resource.data.winnerId ==
               (('winnerId' in resource.data) ? resource.data.winnerId : null)) ||
            (request.resource.data.status == 'finished' && isMatchWinner())) &&
           isMatchScoreUpdate())
        );
      allow delete: if isAppUser() &&
        request.auth.uid == resource.data.hostId;
    }
    match /tt_rooms/{roomId} {
      allow read: if isAppUser();
      allow create: if isAppUser() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'waiting';
      allow update: if isAppUser() &&
        request.resource.data.status in ['waiting', 'playing', 'finished'] &&
        request.resource.data.hostUid == resource.data.hostUid &&
        (
          // Claim the empty seat once; existing players cannot replace it.
          (resource.data.status == 'waiting' && resource.data.guestUid == null &&
           request.auth.uid != resource.data.hostUid &&
           request.resource.data.guestUid == request.auth.uid &&
           request.resource.data.status == 'playing' &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['guestUid', 'status', 'lastTick', 'updatedAt'])) ||
          ((request.auth.uid == resource.data.hostUid ||
            request.auth.uid == resource.data.guestUid) &&
           request.resource.data.guestUid == resource.data.guestUid)
        );
      allow delete: if isAppUser() &&
        request.auth.uid == resource.data.hostUid;
    }
    match /watch_list/{docId} {
      allow read: if isCouple() ||
        (isCinemaProfile() && resource.data.userName == username());
      allow create: if isCouple() ||
        (isCinemaProfile() && request.resource.data.userName == username());
      // Split: request.resource is null on delete, so the combined form
      // denied every cinema-profile removal (Breyan/Octagram could add
      // movies but never remove them).
      allow update: if isCouple() ||
        (isCinemaProfile() && resource.data.userName == username() &&
         request.resource.data.userName == resource.data.userName);
      allow delete: if isCouple() ||
        (isCinemaProfile() && resource.data.userName == username());
    }
    match /fcm_tokens/{docId} {
      // Keep legacy token/Motchi preference documents server-only. Push
      // registrations now live per installation under devices/.
      allow read, write: if false;
      match /devices/{deviceId} {
        allow read: if false;
        allow create, update: if isCouple() && docId == username() &&
          request.resource.data.keys().hasAll(['token', 'uid', 'updatedAt', 'platform']) &&
          request.resource.data.keys().hasOnly(['token', 'uid', 'updatedAt', 'platform']) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.token.size() <= 4096 &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.platform is string;
        allow delete: if isCouple() && docId == username();
      }
    }
    match /config/{docId} {
      allow read: if isRegistered();
    }
    match /spotify_tokens/{userId} {
      allow read, write: if ownerOf(userId);
    }

    // Server-only collections
    match /auth_attempts/{attemptId} { allow read, write: if false; }
    match /api_usage/{uid} { allow read, write: if false; }
    match /api_usage/{uid}/days/{dayId} { allow read, write: if false; }
    match /reminders/{docId} { allow read, write: if false; }
    match /music/{docId} { allow read, write: if false; }
    match /garden_plants/{docId} { allow read, write: if false; }
    match /canvas_drawings/{docId} { allow read, write: if false; }
    match /playzone_scores/{docId} { allow read, write: if false; }
    match /relationship_stats/{docId} { allow read, write: if false; }
    match /motchi_notes/{docId} { allow read, write: if false; }
    match /motchi_actions/{docId} { allow read, write: if false; }
    match /motchi_stats/{docId} { allow read, write: if false; }
    match /motchi_stats/{docId}/{subcol}/{subId} { allow read, write: if false; }
    match /motchi_sessions/{docId} { allow read: if isCouple(); allow write: if false; }
    match /daily_digest/{docId} { allow read, write: if false; }

    // Secure default: deny everything not explicitly allowed above.
    match /{document=**} { allow read, write: if false; }
  }
}

