rules_version = '2';

// Everglow Firestore security rules. The companion to storage.rules
// in this repo. This file is now the single source of truth for
// ALL Firestore collections — deploying it won't break anything.
//
// Couple-only collections (watch_party_rooms, watch_party_chats,
// voice_rooms, sanctuary_messages) are restricted to Khent and
// Clair. All other collections allow any authenticated user.
//
// Watch Together collections are keyed on a deterministic
// `${lowerUid}_${higherUid}` document id (see
// WatchPartyRoom.buildRoomId). Both members of the couple need
// read/write access; no one else is allowed to read or mutate them.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Watch Together rooms ──────────────────────────────────────
    // The room that mirrors playback state between the host and the
    // partner. Document id is the sorted-joined uids, so both halves
    // of the couple compute the same id without coordination.
    match /watch_party_rooms/{roomId} {
      // Read: either the host or the partner (the document id is
      // the joined, sorted uids, so we check against both fields).
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid == resource.data.partnerUid
      );

      // Create: the caller must be either the host or the partner
      // (we let the host write the first version of the room — the
      // host is whichever uid the client writes into `hostUid`).
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.hostUid ||
        request.auth.uid == request.resource.data.partnerUid
      ) && isValidRoomShape(request.resource.data);

      // Update: same access rule, plus a constraint that the
      // hostUid / partnerUid pair can never be reassigned. The
      // couple is fixed for the lifetime of the room; only state
      // and timestamps change.
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid == resource.data.partnerUid
      ) && isValidRoomShape(request.resource.data) && (
        request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.partnerUid == resource.data.partnerUid
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid == resource.data.partnerUid
      );
    }

    // ─── Watch Together chat ───────────────────────────────────────
    // Persistent chat history scoped to a watch party room. Tied to
    // the couple (roomId is the sorted uids), not to the media — so
    // switching movies keeps the chat history alive.
    match /watch_party_chats/{roomId}/messages/{messageId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.hostUid ||
        request.auth.uid == get(/databases/$(database)/documents/watch_party_rooms/$(roomId)).data.partnerUid
      );
    }

    // ─── Voice rooms (WebRTC signaling) ───────────────────────────
    // One document per active call between the couple. Carries the
    // SDP offer/answer. The candidates subcollection carries trickle
    // ICE candidates. Restricted to the two uids named in the room
    // document so a third party cannot snoop on the call.
    //
    // The room is created by the caller (callerUid == auth.uid) and
    // updated by either side. We explicitly forbid reassigning the
    // caller/callee pair — once a call is up, the two ends are
    // fixed for its lifetime.
    match /voice_rooms/{roomId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.calleeUid
      );

      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.callerUid ||
        request.auth.uid == request.resource.data.calleeUid
      ) && isValidVoiceRoomShape(request.resource.data);

      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.calleeUid
      ) && isValidVoiceRoomShape(request.resource.data) && (
        request.resource.data.callerUid == resource.data.callerUid &&
        request.resource.data.calleeUid == resource.data.calleeUid
      );

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.calleeUid
      );

      match /candidates/{candidateId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.callerUid ||
          request.auth.uid == get(/databases/$(database)/documents/voice_rooms/$(roomId)).data.calleeUid
        );
      }
    }

    // ─── Sanctuary Chat (dashboard) ────────────────────────────────
    // Hard-coded to the two known couple uids. Mirrors the rule
    // currently managed in the Firebase console, redeclared here
    // so the repo is the source of truth.
    match /sanctuary_messages/{messageId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == 'bqS6Y5JlzuUB1YcbzUUK7MRpEqA2' ||
        request.auth.uid == 'nitw0mxAR9WtxtzQtLNHYWRjENj2'
      );
    }

    // ─── General app collections (authenticated access only) ──────
    // These were previously managed in the Firebase console. We
    // redeclare them here so the repo is the single source of
    // truth and a `firebase deploy --only firestore:rules` does
    // not break existing features.
    //
    // For a private 4-user app, any authenticated user (Khent,
    // Clair, Breyan, Octagram, or anonymous) can read and write
    // their own data in these collections.
    // �?�?�? Table Tennis 1v1 rooms �?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?
    // Auto-detect rooms for Table Tennis 1v1. Host creates a waiting room,
    // guest detects it and joins. Host is authoritative for ball state.
    match /tt_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if isAuthenticated()
        && (request.auth.uid == resource.data.hostUid
            || request.auth.uid == resource.data.guestUid);
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.hostUid;
    }

    match /academy_questions/{docId} { allow read, write: if isAuthenticated(); }
    match /active_matches/{docId} { allow read, write: if isAuthenticated(); }
    match /date_ideas/{docId} { allow read, write: if isAuthenticated(); }
    match /garden_stats/{docId} { allow read, write: if isAuthenticated(); }
    match /guardian_messages/{docId} { allow read, write: if isAuthenticated(); }
    match /hexgl_best_times/{docId} { allow read, write: if isAuthenticated(); }
    match /hexgl_challenges/{docId} { allow read, write: if isAuthenticated(); }
    match /live_canvas/{docId} { allow read, write: if isAuthenticated(); }
    match /manga_library/{docId} { allow read, write: if isAuthenticated(); }
    match /memories/{docId} { allow read, write: if isAuthenticated(); }
    match /milestones/{docId} { allow read, write: if isAuthenticated(); }
    match /moods/{docId} { allow read, write: if isAuthenticated(); }
    match /notes/{docId} { allow read, write: if isAuthenticated(); }
    match /presence/{docId} { allow read, write: if isAuthenticated(); }
    match /progress/{docId} { allow read, write: if isAuthenticated(); }
    match /read_list/{docId} { allow read, write: if isAuthenticated(); }
    match /starlight_jar/{docId} { allow read, write: if isAuthenticated(); }
    match /users/{docId} { allow read, write: if isAuthenticated(); }
    match /watch_list/{docId} { allow read, write: if isAuthenticated(); }
  }
}

// ─── Helpers ────────────────────────────────────────────────────────

function isAuthenticated() {
  return request.auth != null && request.auth.uid != null;
}

// Shape validation. We only require a few critical fields; the rest
// are app-defined and may grow over time. The `mediaType` enum
// protects against arbitrary writes (someone could otherwise create
// a doc with a 10MB string and burn our bandwidth).
function isValidRoomShape(data) {
  return data.keys().hasAll([
        'hostUid',
        'hostName',
        'partnerUid',
        'partnerName',
        'mediaType',
        'state',
        'updatedAt',
        'updatedBy',
        'active',
      ]) &&
      data.mediaType in ['movie', 'tv'] &&
      data.state in ['playing', 'paused', 'buffering'] &&
      data.active is bool;
}

// Shape validation for voice_rooms. Keeps the SDP payloads bounded
// and forbids arbitrary state strings. State is one of the WebRTC
// call phases the client writes: 'ringing' (host has published an
// offer and is waiting for the partner), 'calling' (partner has
// answered and the call is connecting), 'connected' (peer
// connection open), or 'ended' (graceful hangup).
function isValidVoiceRoomShape(data) {
  return data.keys().hasAll(['callerUid', 'calleeUid', 'state', 'updatedAt']) &&
      data.callerUid is string &&
      data.calleeUid is string &&
      data.state in ['ringing', 'calling', 'connected', 'ended'] &&
      (!('offer' in data) || data.offer is string) &&
      (!('answer' in data) || data.answer is string);
}
